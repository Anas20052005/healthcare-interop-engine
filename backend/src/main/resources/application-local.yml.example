# Local Development Configuration Template
# To use: Copy this file to 'application-local.yml' in 'backend/src/main/resources/' or 'backend/'.
# 'application-local.yml' is ignored by Git (.gitignore) and will never be committed.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/hl7_fhir_engine?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
    username: root
    password: local_dev_mysql_password

jwt:
  secret: local-development-only-jwt-secret-key-at-least-32-bytes-long

app:
  token-encryption-key: local-development-only-token-encryption-key-distinct-from-jwt
  admin:
    password: localDevAdminPassword123!
