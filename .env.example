# Healthcare Interoperability Engine - Environment Configuration Template
# Copy this file to .env and provide real, secure values for your deployment environment.
# NEVER commit the actual .env file with secrets into version control.

# Database Configuration
DB_PORT=3306
DB_NAME=hl7_fhir_engine
DB_USERNAME=interop_user
DB_USER=interop_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-strong-mysql-root-password

# Optional direct JDBC URL override (if not using default host/port/database URL construction)
# DB_URL=jdbc:mysql://localhost:3306/hl7_fhir_engine?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Backend Security Keys (Must be high-entropy, >= 32 characters / 256-bit)
JWT_SECRET=replace-with-a-very-long-secure-random-jwt-secret-at-least-32-bytes
JWT_EXPIRATION=86400000

# Dedicated Destination Credential Encryption Key (Must be independent and distinct from JWT_SECRET, >= 32 characters)
TOKEN_ENCRYPTION_KEY=replace-with-a-dedicated-destination-encryption-secret-32bytes

# Environment Profile & Seeding
SPRING_PROFILES_ACTIVE=prod
SEED_MOCK_DESTINATION=false
SEED_ADMIN_USER=true
# In production, change ADMIN_PASSWORD to a strong secret before initial startup.
# If left empty or set to admin123 in production, the engine will refuse to seed the account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true

# Ports & Networking
BACKEND_PORT=8080
FRONTEND_PORT=80
CORS_ALLOWED_ORIGINS=https://healthcare-interop-engine-frontend.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost,http://localhost:80
